{
    "url": "/open/workspaces/{{parameters.workspaceId}}/forms",
    "method": "GET",
    "qs": {
        "per_page": 100
    },
    "response": {
        "limit": 300,
        "output": {
            "label": "{{item.title}}",
            "value": "{{item.id}}"
        },
        "iterate": "{{body.data}}"
    },
    "pagination": {
        "mergeWithParent": true,
        "url": "{{body.links.next}}",
        "condition": "{{body.links.next}}"
    }
}
