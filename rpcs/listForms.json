{
    "url": "{{ifempty(connection.baseUrl, 'https://api.opnform.com')}}/external/make/forms",
    "method": "GET",
    "headers": {
        "Authorization": "Bearer {{connection.apiKey}}"
    },
    "qs": {
        "workspace_id": "{{parameters.workspaceId}}"
    },
    "response": {
        "output": {
            "label": "{{item.name}}",
            "value": "{{item.id}}"
        },
        "iterate": "{{body}}",
        "error": {
            "message": "{{ifempty(body.message, statusCode)}}"
        }
    }
}
