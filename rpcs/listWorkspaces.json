{
    "url": "{{ifempty(connection.baseUrl, 'https://api.opnform.com')}}/open/workspaces",
    "headers": {
        "Authorization": "Bearer {{connection.apiKey}}"
    },
    "response": {
        "output": {
            "label": "{{item.name}}",
            "value": "{{item.id}}"
        },
        "iterate": "{{body}}"
    }
}
