{
    "url": "/open/forms/{{parameters.formId}}/integrations",
    "method": "POST",
    "headers": {
        "Content-Type": "application/json"
    },
    "body": {
        "integration_id": "make",
        "status": "active",
        "logic": null,
        "data": {
            "webhook_url": "{{webhook.url}}",
            "webhook_secret": "{{temp.webhookSecret}}"
        }
    },
    "response": {
        "data": {
            "externalHookId": "{{body.form_integration.id}}",
            "formId": "{{parameters.formId}}",
            "webhookSecret": "{{temp.webhookSecret}}"
        }
    },
    "temp": {
        "webhookSecret": "{{uuid}}"
    },
    "log": {
        "sanitize": [
            "request.headers.authorization",
            "request.body.data.webhook_secret",
            "response.body.form_integration.data.webhook_secret"
        ]
    }
}
