{
    "url": "/open/forms/{{parameters.formId}}/integrations",
    "method": "POST",
    "headers": {
        "Content-Type": "application/json"
    },
    "body": {
        "integration_id": "make",
        "status": "active",
        "logic": null,
        "data": {
            "webhook_url": "{{webhook.url}}"
        }
    },
    "response": {
        "data": {
            "externalHookId": "{{body.form_integration.id}}",
            "formId": "{{parameters.formId}}"
        }
    }
}
