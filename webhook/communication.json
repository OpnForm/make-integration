{
    "condition": "{{if(data.webhookSecret, get(headers, 'x-webhook-signature') = 'sha256=' + sha256(ifempty(rawBody, ''), 'hex', data.webhookSecret), false)}}",
    "output": "{{body}}",
    "respond": {
        "type": "json",
        "status": 200,
        "body": {
            "ok": true
        }
    }
}
